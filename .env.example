# Local development sample values only. Do not commit .env.

OPENDX_ENV=development
API_PORT=4000
LOG_FORMAT=pretty
LOG_LEVEL=info
METRICS_ENABLED=false
METRICS_PATH=/metrics
READINESS_TIMEOUT_MS=2000
JSON_BODY_LIMIT=1mb
CONSOLE_ORIGIN=http://localhost:3000
STOREFRONT_ORIGIN=http://localhost:3100
STOREFRONT_HOST=shop.example.com
CONSOLE_HOST=console.example.com
API_HOST=api.example.com
KEYCLOAK_HOST=auth.example.com
DATABASE_URL=postgres://opendx_local:opendx_local_password@localhost:5432/opendx
AGENTIC_ANALYTICS_DATABASE_URL=postgres://opendx_agentic_reader:opendx_agentic_reader_password@localhost:5432/opendx

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=opendx
POSTGRES_USER=opendx_local
POSTGRES_PASSWORD=opendx_local_password
POSTGRES_ADMIN_PASSWORD=opendx_admin_password
POSTGRES_AGENTIC_READER_PASSWORD=opendx_agentic_reader_password
TEMPORAL_DB_PASSWORD=temporal_local_password

# Change this and every localhost Keycloak URL below together when 8080 is busy.
KEYCLOAK_PORT=8080
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=opendx
KEYCLOAK_ISSUER=http://localhost:8080/realms/opendx
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/opendx/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=opendx-api
AGENTIC_CONTROL_AUDIENCE=opendx-ai-runtime
AGENTIC_CONTROL_CLIENT_ID=opendx-agentic-control
AGENTIC_CONTROL_CLIENT_SECRET=
AGENT_AI_CEO_CLIENT_ID=agent-ai-ceo
AGENT_AI_CEO_CLIENT_SECRET=
AGENT_CATALOG_CLIENT_ID=agent-catalog
AGENT_CATALOG_CLIENT_SECRET=
AGENT_INVENTORY_CLIENT_ID=agent-inventory
AGENT_INVENTORY_CLIENT_SECRET=
AGENT_ORDER_CLIENT_ID=agent-order
AGENT_ORDER_CLIENT_SECRET=
AGENT_FINANCE_CLIENT_ID=agent-finance
AGENT_FINANCE_CLIENT_SECRET=
AGENT_CRM_CLIENT_ID=agent-crm
AGENT_CRM_CLIENT_SECRET=
AGENT_SUPPORT_CLIENT_ID=agent-support
AGENT_SUPPORT_CLIENT_SECRET=
AGENT_MARKETING_CONTENT_CLIENT_ID=agent-marketing-content
AGENT_MARKETING_CONTENT_CLIENT_SECRET=
AGENT_MARKETING_VISUAL_CLIENT_ID=agent-marketing-visual
AGENT_MARKETING_VISUAL_CLIENT_SECRET=
AGENT_MARKETING_PUBLISHER_CLIENT_ID=agent-marketing-publisher
AGENT_MARKETING_PUBLISHER_CLIENT_SECRET=
KEYCLOAK_TOKEN_URL=http://localhost:8080/realms/opendx/protocol/openid-connect/token
AI_RUNTIME_INTERNAL_URL=http://ai-runtime:8000
OPENROUTER_EXECUTION_ENABLED=false
OPENROUTER_API_KEY=
AGENTIC_EXECUTION_ENABLED=true
WORKFLOW_GATEWAY_TIMEOUT_MS=5000
WORKFLOW_DISPATCHER_INTERVAL_MS=5000
WORKFLOW_DISPATCHER_BATCH_SIZE=20
AGENTIC_WORKER_AUDIENCE=opendx-api
AGENTIC_WORKER_CLIENT_ID=opendx-agentic-worker
AGENTIC_WORKER_CLIENT_SECRET=
AGENTIC_API_BASE_URL=http://api:4000/v1/internal/agentic
DEPARTMENT_TOOL_API_BASE_URL=http://api:4000/v1/internal/agentic
ORCHESTRATION_DESCRIPTOR_EXECUTION_ENABLED=false
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=opendx
TEMPORAL_TASK_QUEUE=store-health-v1
TEMPORAL_TLS_ENABLED=false
TEMPORAL_TLS_CA_PATH=
TEMPORAL_TLS_CERT_PATH=
TEMPORAL_TLS_KEY_PATH=
TEMPORAL_TLS_SERVER_DIR=
TEMPORAL_TLS_CLIENT_DIR=
TEMPORAL_TLS_SERVER_NAME=temporal.internal
TEMPORAL_TLS_GROUP_ID=20000
ACTIVITY_START_TO_CLOSE_SECONDS=30
ACTIVITY_SCHEDULE_TO_CLOSE_SECONDS=180
FAKE_ACTIVITY_DELAY_MS=3000
WORKER_SHUTDOWN_GRACE_SECONDS=30
COMMAND_RETRY_INTERVAL_SECONDS=5
KEYCLOAK_ADMIN=opendx_admin
KEYCLOAK_ADMIN_PASSWORD=opendx_admin_password
KEYCLOAK_DEV_ADMIN_PASSWORD=opendx_admin_change_me
KEYCLOAK_DEV_CATALOG_PASSWORD=opendx_catalog_change_me
KEYCLOAK_DEV_INVENTORY_PASSWORD=opendx_inventory_change_me
KEYCLOAK_DEV_OPERATIONS_PASSWORD=opendx_operations_change_me
KEYCLOAK_DEV_FINANCE_PASSWORD=opendx_finance_change_me
KEYCLOAK_DEV_AGENTIC_OPERATOR_PASSWORD=opendx_agentic_operator_change_me
KEYCLOAK_DEV_AGENTIC_APPROVER_PASSWORD=opendx_agentic_approver_change_me
KEYCLOAK_DEV_AGENTIC_GOVERNANCE_CREATOR_PASSWORD=opendx_agentic_governance_creator_change_me
KEYCLOAK_DEV_AGENTIC_GOVERNANCE_REVIEWER_PASSWORD=opendx_agentic_governance_reviewer_change_me

VITE_API_BASE_URL=http://localhost:4000
VITE_STOREFRONT_ORIGIN=http://localhost:3100
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
CUSTOMER_COOKIE_NAME=opendx_customer
GUEST_COOKIE_NAME=opendx_guest
CSRF_COOKIE_NAME=opendx_csrf
COOKIE_SECURE=false
CUSTOMER_SESSION_TTL_SECONDS=2592000
GUEST_SESSION_TTL_SECONDS=604800
AUTH_RATE_LIMIT=20
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/opendx
VITE_OIDC_CLIENT_ID=opendx-console
VITE_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/sign-in

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=opendx_minio
MINIO_SECRET_KEY=opendx_minio_password
MINIO_BUCKET=product-media
AGENTIC_FILE_LIFECYCLE_INTERVAL_MS=30000
AGENTIC_FILE_LIFECYCLE_BATCH_SIZE=20
# Agentic CSV/TXT intake is private and stored under the same local MinIO bucket.
# Uploads are capped by the API at 2 MiB; no public URL or download endpoint exists.
MINIO_SUPPORT_BUCKET=support-attachments
MEDIA_MAX_BYTES=10485760
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
SUPPORT_ATTACHMENT_SCAN_INTERVAL_SECONDS=30
SUPPORT_ESCALATION_INTERVAL_SECONDS=30
SUPPORT_ATTACHMENT_RETENTION_INTERVAL_SECONDS=3600
INVENTORY_RESERVATION_TTL_SECONDS=900
INVENTORY_EXPIRY_INTERVAL_SECONDS=30
CHECKOUT_TTL_SECONDS=900
CHECKOUT_EXPIRY_INTERVAL_SECONDS=30

# SePay Payment Gateway. Leave all credentials empty for normal local startup.
# Production testing from a local machine still requires public HTTPS API and
# Storefront tunnels, secure cookies, and production callback URLs. See
# docs/integrations/sepay.md.
SEPAY_ENVIRONMENT=sandbox
SEPAY_CHECKOUT_URL=https://pay-sandbox.sepay.vn/v1/checkout/init
SEPAY_API_BASE_URL=https://pgapi-sandbox.sepay.vn
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_IPN_SECRET=
SEPAY_SUCCESS_URL=http://localhost:3100/payment/return?outcome=success
SEPAY_ERROR_URL=http://localhost:3100/payment/return?outcome=error
SEPAY_CANCEL_URL=http://localhost:3100/payment/return?outcome=cancel
SEPAY_REQUEST_TIMEOUT_MS=5000
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=60
PRODUCTION_SEPAY_ACCEPTANCE_AMOUNT_VND=10000
PRODUCTION_SEPAY_ACCEPTANCE_CONFIRMATION=

# Marketing & Social Publication (Facebook / Instagram)
MARKETING_PUBLICATION_POLL_INTERVAL_MS=5000
MARKETING_TARGET_LEASE_SECONDS=30
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_TIMEOUT_MS=10000
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_PUBLICATION_MODE=simulation
INSTAGRAM_ACCOUNT_CONFIGURATION_ID=instagram-local-simulation
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_PUBLIC_MEDIA_BASE_URL=
MARKETING_PUBLIC_MEDIA_SIGNING_SECRET=
MARKETING_PUBLIC_MEDIA_URL_TTL_SECONDS=900
MARKETING_INSTAGRAM_JPEG_QUALITY=90
MARKETING_PUBLIC_MEDIA_RATE_LIMIT=120
MARKETING_PUBLIC_MEDIA_RATE_WINDOW_MS=60000
