{
  "name": "opendx-companyos",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "audit:repo": "bash scripts/audit/repo.sh",
    "audit:env": "node scripts/audit/env-example-check.mjs",
    "audit:secrets": "node scripts/audit/no-secret-fixtures.mjs",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:ts": "pnpm --filter './packages/**' --filter './apps/**' test",
    "test:py": "cd services/ai-runtime && \"${PYTHON_BIN:-python3}\" -m pytest",
    "check:storefront-browser": "node scripts/dev/storefront-browser-check.mjs",
    "check:console-browser": "node scripts/dev/console-browser-check.mjs",
    "check:crm-support-dashboard-browser": "node scripts/dev/crm-support-dashboard-browser-check.mjs",
    "check:crm-support-dashboard-lifecycle": "node scripts/dev/crm-support-dashboard-lifecycle-check.mjs",
    "check:commerce-exit": "node scripts/dev/commerce-exit-check.mjs",
    "test:crm-support-dashboard-exit": "node --test scripts/dev/crm-support-dashboard-exit-check.test.mjs",
    "check:crm-support-dashboard": "pnpm test:crm-support-dashboard-exit && node scripts/dev/crm-support-dashboard-exit-check.mjs",
    "check:sepay-sandbox": "node scripts/dev/sepay-sandbox-acceptance.mjs",
    "test:sepay-production-acceptance": "node --test scripts/dev/sepay-production-acceptance.test.mjs",
    "check:sepay-production": "pnpm test:sepay-production-acceptance && node scripts/dev/sepay-production-acceptance.mjs",
    "check:production-compose": "node scripts/dev/production-compose-check.mjs",
    "check:authorization-matrix": "node scripts/dev/authorization-matrix-check.mjs",
    "check:backup-restore": "node scripts/dev/backup-restore-check.mjs",
    "test:make-database-backup": "node --test scripts/dev/make-database-backup.test.mjs",
    "check:agentic-workflow-recovery": "node scripts/dev/agentic-workflow-recovery-check.mjs",
    "test:temporal-compose": "node --test scripts/dev/temporal-compose-check.test.mjs",
    "test:agentic-production-compose": "node --test scripts/dev/agentic-production-compose-check.test.mjs",
    "check:agentic-production-compose": "pnpm test:agentic-production-compose && node scripts/dev/agentic-production-compose-check.mjs",
    "check:agentic-workflow": "node scripts/dev/agentic-workflow-lifecycle-check.mjs",
    "test:agentic-phase-b-exit": "node --test scripts/dev/agentic-phase-b-exit-check.test.mjs",
    "check:agentic-phase-b-exit": "pnpm test:agentic-phase-b-exit && node scripts/dev/agentic-phase-b-exit-check.mjs",
    "test:agentic-department-tools": "node --test scripts/dev/agentic-department-tools-check.test.mjs",
    "check:agentic-department-tools": "pnpm test:agentic-department-tools && node scripts/dev/agentic-department-tools-check.mjs",
    "test:agentic-phase-c-exit": "node --test scripts/dev/agentic-phase-c-exit-check.test.mjs",
    "check:agentic-phase-c-exit": "pnpm test:agentic-phase-c-exit && node scripts/dev/agentic-phase-c-exit-check.mjs",
    "test:agentic-model-runtime": "node --test scripts/dev/agentic-model-runtime-check.test.mjs",
    "check:agentic-model-runtime": "pnpm test:agentic-model-runtime && node scripts/dev/agentic-model-runtime-check.mjs",
    "test:openrouter-live": "node --test scripts/dev/openrouter-live-acceptance.test.mjs",
    "run:openrouter-live": "bash -ec 'test -n \"$OPENROUTER_CONFIGURATION_EXPORT\" || { echo \"OPENROUTER_CONFIGURATION_EXPORT is required\" >&2; exit 2; }; python3 scripts/dev/openrouter-live-acceptance.py \"$OPENROUTER_CONFIGURATION_EXPORT\"'",
    "check:openrouter-live": "pnpm test:openrouter-live && pnpm run:openrouter-live",
    "test:catalog-live-acceptance": "node --test scripts/dev/catalog-live-acceptance.test.mjs",
    "run:catalog-live-acceptance": "node scripts/dev/catalog-live-acceptance.mjs",
    "diagnose:catalog-live": "node scripts/dev/catalog-live-acceptance-diagnose.mjs",
    "test:agentic-phase-d-exit": "node --test scripts/dev/agentic-phase-d-exit-check.test.mjs",
    "check:agentic-phase-d-exit": "pnpm test:agentic-phase-d-exit && node scripts/dev/agentic-phase-d-exit-check.mjs",
    "test:agentic-phase-e-exit": "node --test scripts/dev/agentic-phase-e-exit-check.test.mjs",
    "check:agentic-phase-e-exit": "pnpm test:agentic-phase-e-exit && node scripts/dev/agentic-phase-e-exit-check.mjs",
    "test:agentic-phase-f-orchestration": "node --test scripts/dev/agentic-phase-f-orchestration-check.test.mjs && pnpm test:py -- tests/agentic/workflows/test_store_health_orchestration.py::test_phase_f_acceptance_restarts_worker_replays_history_without_duplicate_effects",
    "check:agentic-phase-f-orchestration": "pnpm test:agentic-phase-f-orchestration && node scripts/dev/agentic-phase-f-orchestration-check.mjs",
    "test:agentic-console-browser": "node --test scripts/dev/agentic-console-browser-check.test.mjs",
    "check:agentic-console-browser": "pnpm test:agentic-console-browser && node scripts/dev/agentic-console-browser-check.mjs",
    "test:agentic-phase-g-exit": "node --test scripts/dev/agentic-phase-g-exit-check.test.mjs",
    "check:agentic-phase-g-exit": "pnpm test:agentic-phase-g-exit && node scripts/dev/agentic-phase-g-exit-check.mjs",
    "check:phase8-accessibility": "node scripts/dev/phase8-accessibility-check.mjs",
    "check:phase8-performance": "node scripts/dev/phase8-performance-check.mjs",
    "test:phase8-exit": "node --test scripts/dev/phase8-exit-check.test.mjs",
    "check:phase8-exit": "pnpm test:phase8-exit && node scripts/dev/phase8-exit-check.mjs",
    "check:fast": "bash scripts/dev/check-fast.sh",
    "check:full": "bash scripts/dev/check.sh",
    "check": "pnpm check:fast"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
